# 硬件端运行时产物（不入库）
#
# ⚠️ 注释必须单独占一行。gitignore 不支持行尾注释 ——
# 写成「pattern  # 说明」的话，整行会被当成模式的一部分，
# 规则静默失效。这三条以前就是这么废掉的。

# 断网重传队列：含未上报的服药记录
pending.json

# 放弃补发的记录（人工核对用）
pending_lost.json

# 损坏的队列备份
*.bad

# 测试用的临时队列（含服药事件 payload）
test_pending*.json

# 视觉调参产生的调试图像
debug_shots/

# 预录语音文件（体积大，各人自行录制）
voices/

# 允许把 voices 目录本身留在仓库里（放个说明文件即可）
!voices/.gitkeep

