__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/

# 硬件端运行时产物（不入库）
pending.json          # 断网重传队列：运行中产生，含未上报的服药记录
debug_shots/          # 视觉调参产生的调试图像
voices/               # 预录语音文件（体积大，各人自行录制）

# 允许把 voices 目录本身留在仓库里（放个说明文件即可）
!voices/.gitkeep

