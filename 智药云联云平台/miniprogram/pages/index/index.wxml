<view class="page">

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="empty">
    <view class="empty-title">正在加载…</view>
  </view>

  <!-- 加载失败：区分「环境没配好」和「网络问题」 -->
  <view wx:elif="{{error}}" class="card">
    <view class="empty">
      <view class="empty-title">连接云端失败</view>
      <view class="empty-desc err-msg">{{error}}</view>
      <view class="err-hint">
        如果是第一次跑，检查这两处：
        <view>1. miniprogram/app.js 里的 env 是否填了云开发环境 ID</view>
        <view>2. 云函数是否已经上传部署（8 个）</view>
      </view>
      <button class="btn btn-primary" bindtap="onRetry" style="margin-top:40rpx">重试</button>
    </view>
  </view>

  <!-- 还没绑定药盒 -->
  <block wx:elif="{{empty}}">
    <view class="card">
      <view class="empty">
        <view class="empty-title">还没有绑定药盒</view>
        <view class="empty-desc">绑定后即可在这里看到父母的服药情况</view>
        <view class="empty-desc">绑定码在药盒机身底部</view>
        <button class="btn btn-primary mt" bindtap="goDevice" style="margin-top:40rpx">去绑定药盒</button>
      </view>
    </view>
  </block>

  <!-- 正常内容 -->
  <block wx:else>

    <!-- 今日概览 -->
    <view class="hero">
      <view class="hero-date">{{dateLabel}}</view>
      <view class="hero-main">
        <view class="hero-count">
          <text class="text-xl">{{done}}</text>
          <text class="hero-total">/ {{total}}</text>
        </view>
        <view class="hero-label">今日已完成</view>
      </view>
      <view class="progress-track hero-progress">
        <view class="progress-fill" style="width:{{progress}}%"></view>
      </view>

      <!-- 下次服药 -->
      <view wx:if="{{next}}" class="hero-next">
        <text class="hero-next-label">下次</text>
        <text class="hero-next-time">{{next.time}}</text>
        <text class="hero-next-med">{{next.medicineName}} · {{next.dosageText}}</text>
      </view>
      <view wx:else class="hero-next">
        <text class="hero-next-label">今日用药</text>
        <text class="hero-next-med">已全部完成 ✓</text>
      </view>
    </view>

    <!-- 依从性评分 -->
    <view class="card" wx:if="{{adherence}}">
      <view class="card-title">
        <text>近 7 天服药依从性</text>
        <text class="more" bindtap="goRecords">查看记录 ›</text>
      </view>
      <view class="row-between">
        <view class="row">
          <text class="score-num" style="color:{{adherenceLevel.color}}">{{adherence.score}}</text>
          <view class="score-right">
            <view class="tag" style="background:{{adherenceLevel.color}}1A;color:{{adherenceLevel.color}}">
              {{adherenceLevel.label}}
            </view>
            <view class="text-muted score-sub">共 {{adherence.total}} 次用药</view>
          </view>
        </view>
        <view wx:if="{{adherence.missed > 0}}" class="score-missed">
          <text class="text-danger text-bold">{{adherence.missed}}</text>
          <text class="text-muted"> 次漏服</text>
        </view>
      </view>

      <!-- 逐日趋势。canvas 必须常驻渲染，被 wx:if 藏起来时查不到节点 -->
      <view class="trend-wrap">
        <canvas
          type="2d"
          id="trendCanvas"
          class="trend-canvas"></canvas>
      </view>
      <view class="trend-caption">每日依从性得分（0–100）</view>
    </view>

    <!-- 预警 -->
    <view class="card" wx:if="{{alerts.length > 0}}">
      <view class="card-title"><text>需要关注</text></view>
      <view wx:for="{{alerts}}" wx:key="_id" class="alert-item">
        <view class="alert-dot {{item.level === 'high' ? 'dot-high' : 'dot-medium'}}"></view>
        <view class="alert-body">
          <view class="alert-title">{{item.title}}</view>
          <view class="alert-msg">{{item.message}}</view>
          <view class="text-muted alert-time">{{item.timeText}}</view>
        </view>
      </view>
      <button class="btn btn-ghost" bindtap="goRecords" style="margin-top:16rpx">查看全部记录</button>
    </view>

    <!-- 今日用药明细 -->
    <view class="card">
      <view class="card-title">
        <text>今日用药</text>
        <text class="more" bindtap="goPlans">管理计划 ›</text>
      </view>

      <view wx:if="{{slots.length === 0}}" class="empty" style="padding:60rpx 0">
        <view class="empty-desc">今天没有用药计划</view>
        <button class="btn btn-ghost" bindtap="goPlans" style="margin-top:24rpx">去添加计划</button>
      </view>

      <view wx:for="{{slots}}" wx:key="key" class="slot">
        <view class="slot-time">{{item.time}}</view>
        <view class="slot-body">
          <view class="slot-name">{{item.medicineName}} · {{item.dosageText}}</view>
          <view class="slot-meta">
            {{item.mealRelation}} · {{item.bayIndex + 1}}号仓
            <text wx:if="{{item.sourceLabel}}"> · {{item.sourceLabel}}</text>
          </view>
        </view>
        <view class="slot-right">
          <view class="tag {{item.statusTag}}">{{item.statusLabel}}</view>
          <view
            wx:if="{{item.status === 'pending'}}"
            class="slot-fill"
            data-plan-id="{{item.planId}}"
            data-time="{{item.time}}"
            bindtap="onManualFill">补录</view>
        </view>
      </view>
    </view>

    <!-- 设备状态 -->
    <view class="card">
      <view class="card-title">
        <text>药盒状态</text>
        <text class="more" bindtap="goDevice">管理 ›</text>
      </view>
      <view wx:for="{{devices}}" wx:key="_id" class="device-row">
        <view class="device-status-dot {{item.online ? 'dot-online' : 'dot-offline'}}"></view>
        <view class="device-name">{{item.name}}</view>
        <view class="text-muted">
          {{item.online ? '在线' : '离线'}}
          <text wx:if="{{item.battery !== null && item.battery !== undefined}}"> · 电量 {{item.battery}}%</text>
        </view>
      </view>
    </view>

    <view style="height:40rpx"></view>
  </block>

</view>
