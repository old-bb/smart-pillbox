/* 我的 */

.elder-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F1F3;
}
.elder-row:last-child { border-bottom: none; }

.elder-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4A9D8E, #2E7D6F);
  color: #FFFFFF;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.elder-body { flex: 1; overflow: hidden; }

.elder-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.elder-conditions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.cond-tag {
  font-size: 20rpx;
  color: #2E7D6F;
  background: #E6F4F1;
  padding: 2rpx 14rpx;
  border-radius: 100rpx;
}

.elder-devices {
  font-size: 22rpx;
}

.elder-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: flex-end;
  flex-shrink: 0;
  padding-left: 16rpx;
}

.elder-action {
  font-size: 25rpx;
  color: #2E7D6F;
}

.elder-action.danger { color: #D9534F; }

/* 用药提醒推送 */
.notify-box {
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 6rpx solid #2E7D6F;
}

.notify-box.notify-low {
  background: #FDF7EC;
  border-left-color: #E8A33D;
}

.notify-text {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.75;
}

.notify-btn {
  margin-top: 24rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}

/* 设置行 */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F0F1F3;
  font-size: 28rpx;
}
.setting-row:last-child { border-bottom: none; }

.setting-value {
  font-size: 26rpx;
  color: #9AA0A6;
}

/* 说明 */
.note-title {
  font-size: 27rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.note-body {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.8;
}

/* ── 面板 ── */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 88vh;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #F0F1F3;
}

.sheet-title { font-size: 32rpx; font-weight: 600; }
.sheet-close { font-size: 32rpx; color: #9AA0A6; padding: 0 12rpx; }

.sheet-body {
  flex: 1;
  max-height: 62vh;
  padding: 24rpx 32rpx;
}

.sheet-foot {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F0F1F3;
}
.sheet-foot .btn { flex: 1; }

/* 表单 */
.field { margin-bottom: 32rpx; }

.field-row { display: flex; gap: 24rpx; }
.field.half { flex: 1; }

.field-label {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 14rpx;
}

.field-input {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.gender-row { display: flex; gap: 16rpx; }

.gender-opt {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.gender-opt.active {
  background: #E6F4F1;
  border-color: #2E7D6F;
  color: #2E7D6F;
  font-weight: 600;
}

.cond-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cond-opt {
  padding: 12rpx 28rpx;
  background: #F7F8FA;
  border-radius: 100rpx;
  font-size: 26rpx;
  border: 2rpx solid transparent;
}
.cond-opt.active {
  background: #E6F4F1;
  border-color: #2E7D6F;
  color: #2E7D6F;
  font-weight: 500;
}
